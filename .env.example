# Flask
FLASK_APP=backend.run
# Local development only; unset in production.
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dengue_forecasting
DB_USER=dengue_app
DB_PASSWORD=replace-with-a-secure-password

# CORS and API
FRONTEND_ORIGIN=http://localhost:5173,http://10.153.125.227:5173
VITE_API_BASE_URL=/api

# SMTP required for email verification, password recovery, and contact form delivery.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=15
CONTACT_EMAIL=

# Weather providers (OpenWeather geocoding/current/forecast; NASA POWER history)
OPENWEATHER_API_KEY=
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_RATE_LIMIT_PER_MINUTE=30

# ML data preprocessing defaults (CSV pipeline only; no model training)
ML_DATASET_DIR=backend/app/ml/dataset
ML_INPUT_CSV=backend/app/ml/dataset/dengue_climate.csv
ML_PREPROCESSING_OUTPUT_DIR=backend/app/ml/dataset/processed
ML_TARGET_COLUMN=dengue_cases
ML_TEST_SIZE=0.2
ML_RANDOM_STATE=42
ML_OUTLIER_IQR_MULTIPLIER=1.5

# Database container root password and internal services
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
FRONTEND_PORT=8080

# Runtime paths and rotating logs
UPLOAD_FOLDER=backend/instance/uploads
ML_MODEL_DIR=backend/app/ml/models
ML_PROCESSED_DIR=backend/app/ml/dataset/processed
LOG_DIR=backend/logs
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
