# Flask
FLASK_APP=backend.run
# Local development only; keep disabled when exposing through a tunnel.
FLASK_DEBUG=0
APP_ENV=development
# Automatically verifies accounts and exposes reset links when SMTP is unavailable.
# Development-only; this setting is ignored outside APP_ENV=development.
LOCAL_DEMO_MODE=true
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# MySQL
# Optional local SQLite override, for example sqlite:///dengue_local.sqlite.
# Leave blank to use the MySQL settings below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dengue_forecasting
DB_USER=dengue_app
DB_PASSWORD=replace-with-a-secure-password

# CORS and API
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api

# Gmail SMTP configuration for email verification, password recovery, and contact delivery.
# For Gmail, use smtp.gmail.com, port 587, and an App Password (not your account password).
MAIL_SERVER=smtp.gmail.com
# Gmail submission port with STARTTLS.
MAIL_PORT=587
# Full Gmail address used to authenticate with SMTP.
MAIL_USERNAME=your-gmail-address@gmail.com
# Gmail 16-character App Password; keep this value private.
MAIL_PASSWORD=
# Sender address; for Gmail, use the same address as MAIL_USERNAME.
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com
# Use STARTTLS on port 587 (required for this Gmail configuration).
MAIL_USE_TLS=true
# Optional alternative for providers using implicit TLS, typically on port 465.
MAIL_USE_SSL=false
# SMTP connection timeout in seconds.
MAIL_TIMEOUT_SECONDS=15
CONTACT_EMAIL=

# Background alert delivery and Twilio SMS
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
ALERT_RETRY_DELAY_SECONDS=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Mosquito breeding-site detector
# Supply compatible, trained YOLO weights at this path before enabling inference.
MOSQUITO_DETECTOR_PATH=backend/app/ml/models/mosquito_detector.pt
# MOSQUITO_UPLOAD_DIR=backend/instance/mosquito_detections

# OpenStreetMap hospital discovery (no API key required)
HOSPITAL_OVERPASS_URL=https://overpass-api.de/api/interpreter
HOSPITAL_NOMINATIM_URL=https://nominatim.openstreetmap.org
HOSPITAL_USER_AGENT=DengueWatchHospitalFinder/1.0
HOSPITAL_PROVIDER_TIMEOUT_SECONDS=15

# Weather providers (OpenWeather geocoding/current/forecast; NASA POWER history)
OPENWEATHER_API_KEY=
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_RATE_LIMIT_PER_MINUTE=30

# ML data preprocessing defaults (CSV pipeline only; no model training)
ML_DATASET_DIR=backend/app/ml/dataset
ML_INPUT_CSV=backend/app/ml/dataset/dengue_climate.csv
ML_PREPROCESSING_OUTPUT_DIR=backend/app/ml/dataset/processed
ML_TARGET_COLUMN=dengue_cases
ML_TEST_SIZE=0.2
ML_RANDOM_STATE=42
ML_OUTLIER_IQR_MULTIPLIER=1.5

# Database container root password and internal services
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
FRONTEND_PORT=8080

# Runtime paths and rotating logs
UPLOAD_FOLDER=backend/instance/uploads
ML_MODEL_DIR=backend/app/ml/models
ML_PROCESSED_DIR=backend/app/ml/dataset/processed
LOG_DIR=backend/logs
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
