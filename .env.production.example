APP_ENV=production
FLASK_DEBUG=0
AUTO_MIGRATE_DATABASE=false
SECRET_KEY=GENERATE-A-UNIQUE-32-CHARACTER-OR-LONGER-SECRET
JWT_SECRET_KEY=GENERATE-A-DIFFERENT-UNIQUE-32-CHARACTER-OR-LONGER-SECRET
FRONTEND_ORIGIN=https://your-frontend.example.com
DATABASE_URL=mysql+pymysql://your_user:SET-THROUGH-SECRET-MANAGER@your-managed-mysql-host:3306/dengue_forecasting
# Alternatively, leave DATABASE_URL blank and set all four DB_* values below.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
REDIS_URL=rediss://your-redis-host:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
OPENWEATHER_API_KEY=SET-THROUGH-SECRET-MANAGER
NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal/daily/point
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
# Set these through your deployment secret manager.
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=SET-THROUGH-SECRET-MANAGER
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=15
CONTACT_EMAIL=
VITE_API_BASE_URL=/api
AUTH_RATE_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
ML_MODEL_DIR=/app/backend/app/ml/models
ML_PROCESSED_DIR=/app/backend/app/ml/dataset/processed
UPLOAD_FOLDER=/app/backend/instance/uploads
LOG_DIR=/app/backend/logs
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_RATE_LIMIT_PER_MINUTE=30
